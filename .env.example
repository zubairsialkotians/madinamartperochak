# Madina Mart — one .env per shop's copy of the app
EXPO_PUBLIC_APP_NAME=Madina Mart
EXPO_PUBLIC_API_BASE=https://sialkotians.com
# WP admin → Users → the shop's owner profile → "Shop key"
EXPO_PUBLIC_SHOP_KEY=paste-shop-key-here
EXPO_PUBLIC_PRIMARY_COLOR=#0f7a3d

# Native app identity (used by app.config.js)
APP_NAME=Madina Mart
APP_SLUG=madinamart
APP_BUNDLE_ID=com.sialkotians.madinamart

# Push notifications: EAS project id (npx eas init) and google-services.json for APP_BUNDLE_ID
EAS_PROJECT_ID=
GOOGLE_SERVICES_FILE=./google-services.json
